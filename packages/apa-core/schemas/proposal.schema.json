{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apa.local/schemas/artifact-proposal-v1",
  "title": "APA immutable artifact proposal",
  "type": "object",
  "required": [
    "schema",
    "proposal_id",
    "matter_id",
    "artifact_id",
    "artifact_type",
    "content",
    "inputs",
    "actor",
    "created_at",
    "idempotency_key"
  ],
  "properties": {
    "schema": { "const": "apa-artifact-proposal-v1" },
    "proposal_id": { "type": "string", "pattern": "^prop_[0-9a-f]{24}$" },
    "matter_id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{2,127}$" },
    "artifact_id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{1,127}$" },
    "artifact_type": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{1,127}$" },
    "stage_id": { "type": "string", "pattern": "^apa-[a-z0-9-]+$" },
    "content": { "$ref": "#/$defs/content" },
    "inputs": {
      "type": "array",
      "items": { "$ref": "#/$defs/input" },
      "maxItems": 1000
    },
    "actor": { "$ref": "#/$defs/actor" },
    "created_at": { "type": "string", "format": "date-time" },
    "idempotency_key": { "type": "string", "minLength": 8, "maxLength": 200 },
    "suggested_view": { "$ref": "#/$defs/relativePath" },
    "notes": { "type": "string", "maxLength": 5000 }
  },
  "additionalProperties": false,
  "$defs": {
    "relativePath": {
      "type": "string",
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
    },
    "content": {
      "type": "object",
      "required": ["sha256", "bytes", "media_type", "object_path"],
      "properties": {
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "bytes": { "type": "integer", "minimum": 0 },
        "media_type": { "type": "string", "minLength": 1, "maxLength": 200 },
        "object_path": { "type": "string", "pattern": "^drafts/objects/[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "required": ["ref", "sha256"],
      "properties": {
        "ref": { "type": "string", "minLength": 1, "maxLength": 500 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "revision": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "actor": {
      "type": "object",
      "required": ["kind", "id"],
      "properties": {
        "kind": { "enum": ["agent", "human", "tool"] },
        "id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "provider": { "type": "string", "minLength": 1, "maxLength": 100 },
        "model": { "type": "string", "minLength": 1, "maxLength": 200 }
      },
      "additionalProperties": false
    }
  }
}
