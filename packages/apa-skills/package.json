{
  "name": "@apa/patent-skills",
  "version": "0.1.0",
  "description": "Zero-dependency installer for APA agent skills; form filling is self-contained, while lifecycle CLI gates require an APA checkout.",
  "type": "module",
  "bin": {
    "apa-skills": "bin/apa-skills.mjs"
  },
  "scripts": {
    "start": "node bin/apa-skills.mjs",
    "prepack": "node ../../scripts/gen-skill-docs.mjs --all-hosts && node scripts/bundle-skills.mjs",
    "test": "node --test"
  },
  "files": [
    "bin",
    "src",
    "skills",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "keywords": [
    "apa",
    "agent-native-patent-artifact",
    "patent",
    "skills",
    "claude-code",
    "codex",
    "cursor",
    "cli"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=21.0.0"
  }
}
