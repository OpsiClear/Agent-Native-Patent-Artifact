{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OpsiClear/Agent-Native-Patent-Artifact/blob/main/docs/schemas/apa-missing-parts-response-v1.schema.json",
  "title": "APA blocked missing-parts response manifest v1",
  "type": "object",
  "required": [
    "schema",
    "generated_at",
    "source_record",
    "notice_type",
    "application_type",
    "status",
    "authoritative_deadline",
    "deadline_estimate",
    "issues",
    "document_options",
    "notice_stated_fees",
    "response_channel",
    "deferred_human_actions",
    "completion",
    "boundaries"
  ],
  "properties": {
    "schema": { "const": "apa-missing-parts-response-v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "source_record": {
      "type": "object",
      "required": ["schema", "sha256", "source_pdf_sha256", "source_filename"],
      "properties": {
        "schema": { "const": "apa-correspondence-record-v1" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "source_pdf_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "source_filename": { "type": "string", "pattern": "^[^/\\\\]+$" }
      }
    },
    "notice_type": { "enum": ["provisional-missing-parts", "nonprovisional-missing-parts"] },
    "application_type": { "enum": ["provisional", "utility"] },
    "status": { "const": "BLOCKED-HUMAN-ACTIONS" },
    "authoritative_deadline": { "const": false },
    "deadline_estimate": { "type": "object" },
    "issues": { "type": "array", "minItems": 1 },
    "document_options": { "type": "array", "minItems": 1 },
    "notice_stated_fees": { "type": "array" },
    "response_channel": { "type": "object" },
    "deferred_human_actions": { "type": "array", "minItems": 8 },
    "completion": {
      "type": "object",
      "additionalProperties": { "const": false },
      "minProperties": 9
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": { "const": false },
      "required": [
        "legal_advice",
        "legal_response_selected_by_apa",
        "signed_or_certified_by_apa",
        "entity_status_asserted_by_apa",
        "fee_paid_by_apa",
        "patent_center_submission_by_apa"
      ]
    }
  }
}
